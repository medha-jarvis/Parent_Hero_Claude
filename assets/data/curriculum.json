        {"day": 4, "subtopic": "Word problems", "script": "Solve take-away word problems.", "practice": [{"q":"Priya has 9 sweets. She eats 3. How many left?","a":"6","type":"numeric"},{"q":"10 birds on tree. 4 fly away. How many left?","a":"6","type":"numeric"},{"q":"8-5=?","a":"3","type":"numeric"},{"q":"7 books minus 2 books = ?","a":"5","type":"numeric"},{"q":"9-7=?","a":"2","type":"numeric"},{"q":"6 mangoes. Eat 4. Remaining?","a":"2","type":"numeric"},{"q":"10-6=?","a":"4","type":"numeric"},{"q":"8-4=?","a":"4","type":"numeric"},{"q":"9-6=?","a":"3","type":"numeric"},{"q":"7-6=?","a":"1","type":"numeric"}], "quiz": [{"q":"10 apples. 4 eaten. Left?","options":["5","6","7","8"],"answer":1,"explanation":"10-4=6 apples left!"},{"q":"9-3=?","options":["5","6","7","8"],"answer":1,"explanation":"9-3=6!"},{"q":"8 fish. 5 swim away. Left?","options":["2","3","4","5"],"answer":1,"explanation":"8-5=3 fish!"},{"q":"7-4=?","options":["2","3","4","5"],"answer":1,"explanation":"7-4=3!"},{"q":"6-1=?","options":["4","5","6","7"],"answer":1,"explanation":"6-1=5!"}]},
        {"day": 5, "subtopic": "Review and assessment", "script": "Review all subtraction skills.", "practice": [{"q":"10-4=?","a":"6","type":"numeric"},{"q":"9-5=?","a":"4","type":"numeric"},{"q":"8-3=?","a":"5","type":"numeric"},{"q":"7-4=?","a":"3","type":"numeric"},{"q":"6-2=?","a":"4","type":"numeric"},{"q":"5-3=?","a":"2","type":"numeric"},{"q":"10-7=?","a":"3","type":"numeric"},{"q":"9-8=?","a":"1","type":"numeric"},{"q":"8-6=?","a":"2","type":"numeric"},{"q":"7-7=?","a":"0","type":"numeric"}], "quiz": [{"q":"10-6=?","options":["3","4","5","6"],"answer":1,"explanation":"10-6=4!"},{"q":"9-7=?","options":["1","2","3","4"],"answer":1,"explanation":"9-7=2!"},{"q":"8-5=?","options":["2","3","4","5"],"answer":1,"explanation":"8-5=3!"},{"q":"7-3=?","options":["3","4","5","6"],"answer":1,"explanation":"7-3=4!"},{"q":"6-4=?","options":["1","2","3","4"],"answer":1,"explanation":"6-4=2!"},{"q":"Neha has 8 crayons. Gives 3 to friend. Left?","options":["4","5","6","7"],"answer":1,"explanation":"8-3=5 crayons!"},{"q":"10-9=?","options":["0","1","2","3"],"answer":1,"explanation":"10-9=1!"},{"q":"5-5=?","options":["0","1","2","5"],"answer":0,"explanation":"5-5=0. Nothing left!"},{"q":"9-2=?","options":["6","7","8","9"],"answer":1,"explanation":"9-2=7!"},{"q":"8-8=?","options":["0","1","2","8"],"answer":0,"explanation":"8-8=0. All taken away!"}]}
