        {"day": 2, "subtopic": "Count-back strategy", "script": "Subtract by counting backwards.", "practice": [{"q":"8-2=?","a":"6","type":"numeric"},{"q":"9-3=?","a":"6","type":"numeric"},{"q":"7-2=?","a":"5","type":"numeric"},{"q":"6-3=?","a":"3","type":"numeric"},{"q":"10-2=?","a":"8","type":"numeric"},{"q":"8-3=?","a":"5","type":"numeric"},{"q":"9-4=?","a":"5","type":"numeric"},{"q":"7-3=?","a":"4","type":"numeric"},{"q":"10-3=?","a":"7","type":"numeric"},{"q":"5-3=?","a":"2","type":"numeric"}], "quiz": [{"q":"9-3=?","options":["5","6","7","8"],"answer":1,"explanation":"Count back 3 from 9: 8,7,6!"},{"q":"8-2=?","options":["5","6","7","8"],"answer":1,"explanation":"Count back 2 from 8: 7,6!"},{"q":"7-3=?","options":["3","4","5","6"],"answer":1,"explanation":"Count back 3 from 7: 6,5,4!"},{"q":"10-3=?","options":["6","7","8","9"],"answer":1,"explanation":"Count back 3 from 10: 9,8,7!"},{"q":"6-2=?","options":["3","4","5","6"],"answer":1,"explanation":"Count back 2 from 6: 5,4!"}]},
