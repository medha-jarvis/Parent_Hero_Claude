    {
      "id": "g3_m_div_basic",
      "grade": 3,
      "subject": "math",
      "board": "CBSE",
      "title": "Division Basics",
      "subtitle": "Sharing equally",
      "color": "#1CB0F6",
      "icon": "percent",
      "days": [
        {"day": 1, "subtopic": "Concept of division — equal sharing", "script": "Hook: 12 sweets for 4 friends — how many each?\n\nStep 1: Division means sharing EQUALLY. 12÷4 means put 12 things into 4 equal groups.\n\nStep 2: Use objects to demonstrate. 12 coins, 4 groups → 3 each.\n\nStep 3: Write 12÷4=3. The ÷ sign means 'shared into equal groups'.\n\nPitfall: Confusing division with subtraction. Division creates EQUAL groups.", "practice": [{"q":"12÷4=?","a":"3","type":"numeric"},{"q":"10÷2=?","a":"5","type":"numeric"},{"q":"15÷3=?","a":"5","type":"numeric"},{"q":"20÷5=?","a":"4","type":"numeric"},{"q":"18÷3=?","a":"6","type":"numeric"},{"q":"16÷4=?","a":"4","type":"numeric"},{"q":"20÷4=?","a":"5","type":"numeric"},{"q":"24÷6=?","a":"4","type":"numeric"},{"q":"30÷5=?","a":"6","type":"numeric"},{"q":"18÷6=?","a":"3","type":"numeric"}], "quiz": [{"q":"12÷3=?","options":["3","4","5","6"],"answer":1,"explanation":"12÷3=4. 12 shared into 3 equal groups = 4 each!"},{"q":"20÷4=?","options":["4","5","6","7"],"answer":1,"explanation":"20÷4=5. 20 shared into 4 groups = 5 each!"},{"q":"15÷5=?","options":["2","3","4","5"],"answer":1,"explanation":"15÷5=3!"},{"q":"What does ÷ mean?","options":["Add","Subtract","Share equally","Multiply"],"answer":2,"explanation":"÷ means to share equally into groups!"},{"q":"18÷2=?","options":["7","8","9","10"],"answer":2,"explanation":"18÷2=9!"}]},
        {"day": 2, "subtopic": "Division as repeated subtraction", "script": "Divide by repeated subtraction.", "practice": [{"q":"20÷5=?","a":"4","type":"numeric"},{"q":"18÷3=?","a":"6","type":"numeric"},{"q":"24÷4=?","a":"6","type":"numeric"},{"q":"30÷6=?","a":"5","type":"numeric"},{"q":"21÷7=?","a":"3","type":"numeric"},{"q":"28÷4=?","a":"7","type":"numeric"},{"q":"35÷5=?","a":"7","type":"numeric"},{"q":"36÷6=?","a":"6","type":"numeric"},{"q":"32÷8=?","a":"4","type":"numeric"},{"q":"45÷5=?","a":"9","type":"numeric"}], "quiz": [{"q":"24÷4=?","options":["5","6","7","8"],"answer":1,"explanation":"24÷4=6!"},{"q":"35÷5=?","options":["5","6","7","8"],"answer":2,"explanation":"35÷5=7!"},{"q":"36÷6=?","options":["5","6","7","8"],"answer":1,"explanation":"36÷6=6!"},{"q":"28÷7=?","options":["3","4","5","6"],"answer":1,"explanation":"28÷7=4!"},{"q":"45÷9=?","options":["4","5","6","7"],"answer":1,"explanation":"45÷9=5!"}]},
        {"day": 3, "subtopic": "Division facts (linked to multiplication)", "script": "Use multiplication to find division answers.", "practice": [{"q":"5×?=25, so 25÷5=?","a":"5","type":"numeric"},{"q":"4×?=32, so 32÷4=?","a":"8","type":"numeric"},{"q":"6×?=42, so 42÷6=?","a":"7","type":"numeric"},{"q":"3×?=27, so 27÷3=?","a":"9","type":"numeric"},{"q":"7×?=56, so 56÷7=?","a":"8","type":"numeric"},{"q":"8×?=64, so 64÷8=?","a":"8","type":"numeric"},{"q":"9×?=63, so 63÷9=?","a":"7","type":"numeric"},{"q":"6×?=48, so 48÷6=?","a":"8","type":"numeric"},{"q":"7×?=49, so 49÷7=?","a":"7","type":"numeric"},{"q":"8×?=72, so 72÷8=?","a":"9","type":"numeric"}], "quiz": [{"q":"If 6×8=48, then 48÷8=?","options":["5","6","7","8"],"answer":1,"explanation":"If 6×8=48, then 48÷8=6!"},{"q":"25÷5=?","options":["4","5","6","7"],"answer":1,"explanation":"5×5=25, so 25÷5=5!"},{"q":"63÷9=?","options":["6","7","8","9"],"answer":1,"explanation":"9×7=63, so 63÷9=7!"},{"q":"If 7×8=56, then 56÷7=?","options":["6","7","8","9"],"answer":2,"explanation":"7×8=56, so 56÷7=8!"},{"q":"72÷8=?","options":["7","8","9","10"],"answer":2,"explanation":"8×9=72, so 72÷8=9!"}]},
        {"day": 4, "subtopic": "Word problems", "script": "Apply division to real-life problems.", "practice": [{"q":"24 candies shared among 6 children. Each gets?","a":"4","type":"numeric"},{"q":"35÷7=?","a":"5","type":"numeric"},{"q":"48 books in 8 shelves equally. Books per shelf?","a":"6","type":"numeric"},{"q":"42÷6=?","a":"7","type":"numeric"},{"q":"54÷9=?","a":"6","type":"numeric"},{"q":"36 students in 4 equal groups. Students per group?","a":"9","type":"numeric"},{"q":"56÷8=?","a":"7","type":"numeric"},{"q":"63÷7=?","a":"9","type":"numeric"},{"q":"45÷5=?","a":"9","type":"numeric"},{"q":"72÷9=?","a":"8","type":"numeric"}], "quiz": [{"q":"30 mangoes shared among 5 baskets equally. Each basket gets?","options":["5","6","7","8"],"answer":1,"explanation":"30÷5=6 mangoes each!"},{"q":"56÷8=?","options":["6","7","8","9"],"answer":1,"explanation":"56÷8=7!"},{"q":"45 students in 9 rows. Students per row?","options":["4","5","6","7"],"answer":1,"explanation":"45÷9=5 students per row!"},{"q":"63÷7=?","options":["7","8","9","10"],"answer":2,"explanation":"63÷7=9!"},{"q":"If 48÷6=?, then ?=","options":["6","7","8","9"],"answer":2,"explanation":"48÷6=8!"}]},
