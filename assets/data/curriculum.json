      "days": [
        {"day": 1, "subtopic": "Tens and ones place value", "script": "Hook: 35 means 3 tens and 5 ones!\n\nStep 1: Every 2-digit number has TENS and ONES. 47 = 4 tens + 7 ones. Use a tens/ones chart.\n\nStep 2: Build numbers: give child 5 tens-sticks and 6 ones-blocks = 56.\n\nStep 3: Practice decomposing numbers.\n\nPitfall: Children write digits in wrong columns. Always start from the ONES column.", "practice": [{"q":"How many tens in 45?","a":"4","type":"numeric"},{"q":"How many ones in 73?","a":"3","type":"numeric"},{"q":"3 tens + 8 ones = ?","a":"38","type":"numeric"},{"q":"How many tens in 60?","a":"6","type":"numeric"},{"q":"How many ones in 97?","a":"7","type":"numeric"},{"q":"5 tens + 2 ones = ?","a":"52","type":"numeric"},{"q":"How many tens in 83?","a":"8","type":"numeric"},{"q":"How many ones in 41?","a":"1","type":"numeric"},{"q":"7 tens + 0 ones = ?","a":"70","type":"numeric"},{"q":"9 tens + 9 ones = ?","a":"99","type":"numeric"}], "quiz": [{"q":"How many tens in 56?","options":["5","6","50","60"],"answer":0,"explanation":"56 has 5 tens and 6 ones!"},{"q":"What is 4 tens + 3 ones?","options":["7","34","43","430"],"answer":2,"explanation":"4 tens + 3 ones = 43!"},{"q":"72 has how many ones?","options":["7","2","70","20"],"answer":1,"explanation":"72 = 7 tens + 2 ones!"},{"q":"Which shows 65?","options":["6 ones+5 tens","6 tens+5 ones","56","65 ones"],"answer":1,"explanation":"65 = 6 tens + 5 ones!"},{"q":"5 tens + 9 ones = ?","options":["14","59","95","509"],"answer":1,"explanation":"5 tens + 9 ones = 59!"}]},
        {"day": 2, "subtopic": "Addition without carrying (2-digit)", "script": "Add tens to tens, ones to ones.", "practice": [{"q":"23+14=?","a":"37","type":"numeric"},{"q":"31+25=?","a":"56","type":"numeric"},{"q":"42+17=?","a":"59","type":"numeric"},{"q":"50+30=?","a":"80","type":"numeric"},{"q":"61+28=?","a":"89","type":"numeric"},{"q":"44+43=?","a":"87","type":"numeric"},{"q":"35+24=?","a":"59","type":"numeric"},{"q":"72+16=?","a":"88","type":"numeric"},{"q":"11+68=?","a":"79","type":"numeric"},{"q":"30+59=?","a":"89","type":"numeric"}], "quiz": [{"q":"23+14=?","options":["36","37","38","39"],"answer":1,"explanation":"Ones: 3+4=7. Tens: 2+1=3. Answer: 37!"},{"q":"42+35=?","options":["76","77","78","79"],"answer":1,"explanation":"Ones: 2+5=7. Tens: 4+3=7. Answer: 77!"},{"q":"50+30=?","options":["70","80","90","100"],"answer":1,"explanation":"5 tens + 3 tens = 8 tens = 80!"},{"q":"61+28=?","options":["88","89","90","91"],"answer":1,"explanation":"Ones: 1+8=9. Tens: 6+2=8. Answer: 89!"},{"q":"33+46=?","options":["78","79","80","81"],"answer":1,"explanation":"Ones: 3+6=9. Tens: 3+4=7. Answer: 79!"}]},
        {"day": 3, "subtopic": "Addition with carrying (ones → tens)", "script": "When ones add up to 10 or more, carry over!\n\nStep 1: 27+15. Ones: 7+5=12. Write 2, carry 1 ten.\nStep 2: Tens: 2+1+1(carried)=4. Answer: 42!\n\nPitfall: Children forget to add the carried digit.", "practice": [{"q":"27+15=?","a":"42","type":"numeric"},{"q":"38+24=?","a":"62","type":"numeric"},{"q":"46+37=?","a":"83","type":"numeric"},{"q":"55+28=?","a":"83","type":"numeric"},{"q":"67+14=?","a":"81","type":"numeric"},{"q":"49+32=?","a":"81","type":"numeric"},{"q":"58+25=?","a":"83","type":"numeric"},{"q":"36+47=?","a":"83","type":"numeric"},{"q":"29+43=?","a":"72","type":"numeric"},{"q":"48+36=?","a":"84","type":"numeric"}], "quiz": [{"q":"27+15=?","options":["41","42","43","44"],"answer":1,"explanation":"Ones: 7+5=12, write 2 carry 1. Tens: 2+1+1=4. Answer: 42!"},{"q":"38+24=?","options":["61","62","63","64"],"answer":1,"explanation":"Ones: 8+4=12, write 2 carry 1. Tens: 3+2+1=6. Answer: 62!"},{"q":"46+37=?","options":["82","83","84","85"],"answer":1,"explanation":"Ones: 6+7=13, write 3 carry 1. Tens: 4+3+1=8. Answer: 83!"},{"q":"55+28=?","options":["82","83","84","85"],"answer":1,"explanation":"Ones: 5+8=13, write 3 carry 1. Tens: 5+2+1=8. Answer: 83!"},{"q":"In carrying, the carried digit goes to which column?","options":["Ones","Tens","Hundreds","Units"],"answer":1,"explanation":"The carried digit goes to the TENS column!"}]},
        {"day": 4, "subtopic": "Word problems with carrying", "script": "Apply carrying to story problems.", "practice": [{"q":"Neha has 28 stickers. Gets 15 more. Total?","a":"43","type":"numeric"},{"q":"37+26=?","a":"63","type":"numeric"},{"q":"Bus has 45 seats. 38 passengers board. Total?","a":"45","type":"numeric"},{"q":"48+35=?","a":"83","type":"numeric"},{"q":"Mum buys 29 apples, Dad buys 34. Total?","a":"63","type":"numeric"},{"q":"57+28=?","a":"85","type":"numeric"},{"q":"65+27=?","a":"92","type":"numeric"},{"q":"39+43=?","a":"82","type":"numeric"},{"q":"46+38=?","a":"84","type":"numeric"},{"q":"57+36=?","a":"93","type":"numeric"}], "quiz": [{"q":"26 + 37 = ?","options":["62","63","64","65"],"answer":1,"explanation":"Ones: 6+7=13, write 3 carry 1. Tens: 2+3+1=6. Answer: 63!"},{"q":"Riya reads 48 pages Monday, 35 Tuesday. Total?","options":["82","83","84","85"],"answer":1,"explanation":"48+35: Ones: 8+5=13, carry 1. Tens: 4+3+1=8. Answer: 83!"},{"q":"45+47=?","options":["91","92","93","94"],"answer":1,"explanation":"Ones: 5+7=12, carry 1. Tens: 4+4+1=9. Answer: 92!"},{"q":"56+38=?","options":["93","94","95","96"],"answer":1,"explanation":"Ones: 6+8=14, carry 1. Tens: 5+3+1=9. Answer: 94!"},{"q":"29+63=?","options":["91","92","93","94"],"answer":1,"explanation":"Ones: 9+3=12, carry 1. Tens: 2+6+1=9. Answer: 92!"}]},
        {"day": 5, "subtopic": "Review and assessment", "script": "Review 2-digit addition with carrying.", "practice": [{"q":"29+13=?","a":"42","type":"numeric"},{"q":"47+26=?","a":"73","type":"numeric"},{"q":"58+34=?","a":"92","type":"numeric"},{"q":"36+48=?","a":"84","type":"numeric"},{"q":"67+25=?","a":"92","type":"numeric"},{"q":"45+37=?","a":"82","type":"numeric"},{"q":"56+28=?","a":"84","type":"numeric"},{"q":"39+54=?","a":"93","type":"numeric"},{"q":"48+47=?","a":"95","type":"numeric"},{"q":"29+65=?","a":"94","type":"numeric"}], "quiz": [{"q":"37+48=?","options":["84","85","86","87"],"answer":1,"explanation":"Ones: 7+8=15, carry 1. Tens: 3+4+1=8. Answer: 85!"},{"q":"56+29=?","options":["84","85","86","87"],"answer":1,"explanation":"Ones: 6+9=15, carry 1. Tens: 5+2+1=8. Answer: 85!"},{"q":"In 83+17, ones are?","options":["3+7=10","8+1=9","3+1=4","8+7=15"],"answer":0,"explanation":"Ones digit: 3+7=10. Write 0, carry 1!"},{"q":"45+55=?","options":["99","100","101","90"],"answer":1,"explanation":"Ones: 5+5=10, carry 1. Tens: 4+5+1=10. Answer: 100!"},{"q":"67+26=?","options":["92","93","94","95"],"answer":1,"explanation":"Ones: 7+6=13, carry 1. Tens: 6+2+1=9. Answer: 93!"},{"q":"School has 48 boys and 36 girls. Total?","options":["83","84","85","86"],"answer":1,"explanation":"48+36=84 students!"},{"q":"38+45=?","options":["82","83","84","85"],"answer":1,"explanation":"Ones: 8+5=13, carry 1. Tens: 3+4+1=8. Answer: 83!"},{"q":"29+64=?","options":["92","93","94","95"],"answer":1,"explanation":"Ones: 9+4=13, carry 1. Tens: 2+6+1=9. Answer: 93!"},{"q":"57+37=?","options":["93","94","95","96"],"answer":1,"explanation":"Ones: 7+7=14, carry 1. Tens: 5+3+1=9. Answer: 94!"},{"q":"46+48=?","options":["93","94","95","96"],"answer":1,"explanation":"Ones: 6+8=14, carry 1. Tens: 4+4+1=9. Answer: 94!"}]}
      ]
