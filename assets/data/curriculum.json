        {"day": 1, "subtopic": "Multiplication as repeated addition", "script": "Hook: 3 bags with 4 apples each = 4+4+4 = 12 apples!\n\nStep 1: Multiplication is a shortcut for repeated addition. 3×4 means add 4 three times.\n\nStep 2: Use objects in equal groups. 2 groups of 5 = 5+5 = 10 = 2×5.\n\nPitfall: Children confuse 3×4 with 4×3. Both equal 12 — multiplication is commutative!", "practice": [{"q":"2+2+2 = 3×2 = ?","a":"6","type":"numeric"},{"q":"5+5 = 2×5 = ?","a":"10","type":"numeric"},{"q":"3+3+3+3 = 4×3 = ?","a":"12","type":"numeric"},{"q":"4+4+4 = 3×4 = ?","a":"12","type":"numeric"},{"q":"2×6 = ?","a":"12","type":"numeric"},{"q":"5×2 = ?","a":"10","type":"numeric"},{"q":"3×5 = ?","a":"15","type":"numeric"},{"q":"2×8 = ?","a":"16","type":"numeric"},{"q":"4×5 = ?","a":"20","type":"numeric"},{"q":"2×10 = ?","a":"20","type":"numeric"}], "quiz": [{"q":"3+3+3 is the same as?","options":["3×3","3+3","9×1","3-3"],"answer":0,"explanation":"3+3+3 = 3×3 = 9!"},{"q":"2×5 = ?","options":["7","10","15","20"],"answer":1,"explanation":"2×5 = 5+5 = 10!"},{"q":"4 bags with 3 apples each = ?","options":["7","10","12","14"],"answer":2,"explanation":"4×3 = 3+3+3+3 = 12!"},{"q":"3×4 equals which?","options":["4+4+4","3+3+3","4×4","3+4"],"answer":0,"explanation":"3×4 means add 4 three times: 4+4+4=12!"},{"q":"2×9 = ?","options":["11","18","20","16"],"answer":1,"explanation":"2×9 = 9+9 = 18!"}]},
        {"day": 2, "subtopic": "Table of 2", "script": "Learn the 2 times table.", "practice": [{"q":"2×1=?","a":"2","type":"numeric"},{"q":"2×2=?","a":"4","type":"numeric"},{"q":"2×3=?","a":"6","type":"numeric"},{"q":"2×4=?","a":"8","type":"numeric"},{"q":"2×5=?","a":"10","type":"numeric"},{"q":"2×6=?","a":"12","type":"numeric"},{"q":"2×7=?","a":"14","type":"numeric"},{"q":"2×8=?","a":"16","type":"numeric"},{"q":"2×9=?","a":"18","type":"numeric"},{"q":"2×10=?","a":"20","type":"numeric"}], "quiz": [{"q":"2×7=?","options":["12","14","16","18"],"answer":1,"explanation":"2×7=14!"},{"q":"2×9=?","options":["16","18","20","22"],"answer":1,"explanation":"2×9=18!"},{"q":"2×5=?","options":["8","10","12","14"],"answer":1,"explanation":"2×5=10!"},{"q":"2×8=?","options":["14","16","18","20"],"answer":1,"explanation":"2×8=16!"},{"q":"? × 2 = 12","options":["4","5","6","7"],"answer":2,"explanation":"6×2=12!"}]},
        {"day": 3, "subtopic": "Table of 5", "script": "Learn the 5 times table.", "practice": [{"q":"5×1=?","a":"5","type":"numeric"},{"q":"5×2=?","a":"10","type":"numeric"},{"q":"5×3=?","a":"15","type":"numeric"},{"q":"5×4=?","a":"20","type":"numeric"},{"q":"5×5=?","a":"25","type":"numeric"},{"q":"5×6=?","a":"30","type":"numeric"},{"q":"5×7=?","a":"35","type":"numeric"},{"q":"5×8=?","a":"40","type":"numeric"},{"q":"5×9=?","a":"45","type":"numeric"},{"q":"5×10=?","a":"50","type":"numeric"}], "quiz": [{"q":"5×4=?","options":["15","20","25","30"],"answer":1,"explanation":"5×4=20!"},{"q":"5×7=?","options":["30","35","40","45"],"answer":1,"explanation":"5×7=35!"},{"q":"5×9=?","options":["40","45","50","55"],"answer":1,"explanation":"5×9=45!"},{"q":"All multiples of 5 end in?","options":["0 or 5","1 or 5","0 or 2","Any digit"],"answer":0,"explanation":"Multiples of 5 always end in 0 or 5!"},{"q":"5×6=?","options":["25","30","35","40"],"answer":1,"explanation":"5×6=30!"}]},
        {"day": 4, "subtopic": "Table of 10", "script": "Learn the 10 times table.", "practice": [{"q":"10×1=?","a":"10","type":"numeric"},{"q":"10×2=?","a":"20","type":"numeric"},{"q":"10×3=?","a":"30","type":"numeric"},{"q":"10×4=?","a":"40","type":"numeric"},{"q":"10×5=?","a":"50","type":"numeric"},{"q":"10×6=?","a":"60","type":"numeric"},{"q":"10×7=?","a":"70","type":"numeric"},{"q":"10×8=?","a":"80","type":"numeric"},{"q":"10×9=?","a":"90","type":"numeric"},{"q":"10×10=?","a":"100","type":"numeric"}], "quiz": [{"q":"10×7=?","options":["60","70","80","90"],"answer":1,"explanation":"10×7=70!"},{"q":"10×4=?","options":["30","40","50","60"],"answer":1,"explanation":"10×4=40!"},{"q":"All multiples of 10 end in?","options":["5","0","1","Any"],"answer":1,"explanation":"Multiples of 10 always end in 0!"},{"q":"10×9=?","options":["80","90","100","110"],"answer":1,"explanation":"10×9=90!"},{"q":"? × 10 = 60","options":["5","6","7","8"],"answer":1,"explanation":"6×10=60!"}]},
        {"day": 5, "subtopic": "Review and mixed tables", "script": "Mix all three tables.", "practice": [{"q":"2×7=?","a":"14","type":"numeric"},{"q":"5×6=?","a":"30","type":"numeric"},{"q":"10×3=?","a":"30","type":"numeric"},{"q":"2×9=?","a":"18","type":"numeric"},{"q":"5×8=?","a":"40","type":"numeric"},{"q":"10×7=?","a":"70","type":"numeric"},{"q":"2×6=?","a":"12","type":"numeric"},{"q":"5×9=?","a":"45","type":"numeric"},{"q":"10×8=?","a":"80","type":"numeric"},{"q":"5×5=?","a":"25","type":"numeric"}], "quiz": [{"q":"2×8=?","options":["14","16","18","20"],"answer":1,"explanation":"2×8=16!"},{"q":"5×7=?","options":["30","35","40","45"],"answer":1,"explanation":"5×7=35!"},{"q":"10×6=?","options":["50","60","70","80"],"answer":1,"explanation":"10×6=60!"},{"q":"Which is biggest: 2×9, 5×4, 10×2?","options":["2×9=18","5×4=20","10×2=20","All equal"],"answer":3,"explanation":"5×4=20 and 10×2=20 are both equal and biggest!"},{"q":"5 boxes with 10 crayons each = ?","options":["15","25","50","55"],"answer":2,"explanation":"5×10=50 crayons!"},{"q":"2×5=?","options":["8","10","12","14"],"answer":1,"explanation":"2×5=10!"},{"q":"10×5=?","options":["15","25","50","55"],"answer":2,"explanation":"10×5=50!"},{"q":"5×3=?","options":["10","15","20","25"],"answer":1,"explanation":"5×3=15!"},{"q":"2×10=?","options":["12","20","22","200"],"answer":1,"explanation":"2×10=20!"},{"q":"? × 5 = 45","options":["7","8","9","10"],"answer":2,"explanation":"9×5=45!"}]}
      ]
